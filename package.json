{
  "name": "creatorcrawl",
  "version": "0.4.0",
  "description": "Official CLI for CreatorCrawl. Scrape TikTok, Instagram, YouTube, LinkedIn, Twitter/X, and Reddit profiles, posts, comments, transcripts, ads, and trending data from your terminal or shell scripts.",
  "license": "MIT",
  "author": "CreatorCrawl <support@creatorcrawl.com>",
  "homepage": "https://creatorcrawl.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creatorcrawl/cli.git"
  },
  "bugs": {
    "url": "https://github.com/creatorcrawl/cli/issues"
  },
  "keywords": [
    "creatorcrawl",
    "cli",
    "social-media-api",
    "tiktok",
    "instagram",
    "youtube",
    "linkedin",
    "twitter",
    "reddit",
    "scraper",
    "command-line"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "bin": {
    "creatorcrawl": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@creatorcrawl/sdk": "github:creatorcrawl/sdk-typescript#v0.3.2",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
